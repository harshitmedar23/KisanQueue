# Copy this file to .env and fill in local values.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY="your_api_key_here"
GEMINI_MODEL=gemini-3.6-flash
VOICE_MAX_AUDIO_BYTES=10485760

# MySQL
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/farmer_procurement_prod

# Demo OTP: True shows the OTP in the browser. Set False only after configuring SMS.
OTP_DEMO_MODE=True

# Static UPI QR identity; staff manually confirm received payments.
# UPI ID that receives farmer payments, for example yourname@okaxis
UPI_VPA=your-vpa@upi
UPI_PAYEE_NAME=Farmer Procurement

# Farmer help desk contact
FARMER_HELP_PHONE=1800-123-4567
FARMER_HELP_EMAIL=help@farmerprocurement.local

# Optional email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=True

# Optional Twilio SMS
SMS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_CONTENT_SID=

# Optional Telegram
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional Web Push
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Optional live mandi-price API (data.gov.in or another JSON API)
MANDI_API_URL=
MANDI_API_KEY=
MANDI_API_LIMIT=100
MANDI_API_CROP_FIELD=commodity
MANDI_API_MARKET_FIELD=market
MANDI_API_PRICE_FIELD=modal_price

SOCKETIO_ASYNC_MODE=threading
RATELIMIT_STORAGE_URI=memory://
